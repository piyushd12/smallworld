GITHUB_TOKEN=

# Optional, for hosting:
# RATE_LIMIT_PER_IP_HOUR=1000   # max GitHub calls one visitor IP can cause per hour
# CACHE_FILE=.cache/github-cache.json   # set empty to keep the cache in memory only
# TRUST_PROXY=1                 # set when running behind a reverse proxy
# Upstash Redis (added automatically on Vercel; optional locally, the disk cache is used without it)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
